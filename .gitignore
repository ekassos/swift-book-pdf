# Byte-compiled / cached files
__pycache__/
_minted-*/
.*_cache/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/
.env/
env/

# Dependency directories
dist/
build/

# Source package named "build".
!src/swift_book_pdf/pdf/latex/build/
!src/swift_book_pdf/pdf/latex/build/*.py
!src/swift_book_pdf/pdf/latex/build/deps/
!src/swift_book_pdf/pdf/latex/build/deps/*.py

# Editor/IDE files
.vscode/

# OS-specific files
.DS_Store
Thumbs.db

# Bundled assets.
src/swift_book_pdf/assets/*

# Shared Swift logo artwork used by PDF output.
# The Swift logo is a trademark of Apple Inc.
!src/swift_book_pdf/assets/swift-logo/
src/swift_book_pdf/assets/swift-logo/*
!src/swift_book_pdf/assets/swift-logo/Swift_logo_color.png
!src/swift_book_pdf/assets/swift-logo/Swift_logo_white.png

# Shared icons used by PDF output.
!src/swift_book_pdf/assets/icons/
src/swift_book_pdf/assets/icons/*
!src/swift_book_pdf/assets/icons/chapter-icon.png
!src/swift_book_pdf/assets/icons/chapter-icon~dark.png

# Shared fonts.
!src/swift_book_pdf/assets/fonts/
src/swift_book_pdf/assets/fonts/*
!src/swift_book_pdf/assets/fonts/ibm-plex/
src/swift_book_pdf/assets/fonts/ibm-plex/*
!src/swift_book_pdf/assets/fonts/ibm-plex/*.ttf

# EPUB-specific cover templates and static CSS.
!src/swift_book_pdf/assets/epub/
src/swift_book_pdf/assets/epub/*
!src/swift_book_pdf/assets/epub/covers/
src/swift_book_pdf/assets/epub/covers/*
!src/swift_book_pdf/assets/epub/covers/cover.png
!src/swift_book_pdf/assets/epub/covers/cover-beta.png
!src/swift_book_pdf/assets/epub/covers/cover-current.png
!src/swift_book_pdf/assets/epub/covers/cover-nightly.png
!src/swift_book_pdf/assets/epub/static/
src/swift_book_pdf/assets/epub/static/*
!src/swift_book_pdf/assets/epub/static/epub.css
!src/swift_book_pdf/assets/epub/static/pygments.css

# Legal notices copied or rendered into generated outputs.
!src/swift_book_pdf/assets/notices/
!src/swift_book_pdf/assets/notices/*
